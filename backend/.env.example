# Copy this file to backend/.env for local development.
# Example only: replace connection placeholders in your private .env.
# This SQLAlchemy URL assumes the psycopg PostgreSQL driver.
# Use the host, port, username, and SSL settings supplied by Supabase.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Keep provider credentials exclusively on the backend.
GEMINI_API_KEY=
# Select a supported model with free-tier access in your provider account.
GEMINI_MODEL=

# Allowed frontend origin for local development; change for deployment.
FRONTEND_ORIGIN=http://localhost:5173
